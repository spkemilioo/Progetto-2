# CLASSE PAZIENTE

class Paziente:

    def __init__(self, nome, cognome, codice_fiscale,
                 eta, peso, analisi_effettuate,
                 risultati_analisi):

        self.nome = nome
        self.cognome = cognome
        self.codice_fiscale = codice_fiscale
        self.eta = eta
        self.peso = peso
        self.analisi_effettuate = analisi_effettuate

        # Conversione dei risultati in un array NumPy
        self.risultati_analisi = np.array(
            risultati_analisi,
            dtype=float
        )

    # Metodo che restituisce la scheda personale

    def scheda_personale(self):

        return (
            f"Nome: {self.nome}\n"
            f"Cognome: {self.cognome}\n"
            f"Codice fiscale: {self.codice_fiscale}\n"
            f"Età: {self.eta}\n"
            f"Peso: {self.peso} kg\n"
            f"Analisi effettuate: {self.analisi_effettuate}"
        )

    # Metodo per calcolare le statistiche con NumPy

    def statistiche_analisi(self):

        media = np.mean(self.risultati_analisi)
        minimo = np.min(self.risultati_analisi)
        massimo = np.max(self.risultati_analisi)
        deviazione = np.std(self.risultati_analisi)

        print("\nSTATISTICHE DEI RISULTATI")
        print("Valori:", self.risultati_analisi)
        print("Media:", round(media, 2))
        print("Minimo:", round(minimo, 2))
        print("Massimo:", round(massimo, 2))
        print("Deviazione standard:", round(deviazione, 2))


# CLASSE MEDICO

class Medico:

    def __init__(self, nome, cognome, specializzazione):

        self.nome = nome
        self.cognome = cognome
        self.specializzazione = specializzazione

    # Metodo per visitare un paziente

    def visita_paziente(self, paziente):

        print(
            f"Il dott. {self.nome} {self.cognome}, "
            f"specialista in {self.specializzazione}, "
            f"sta visitando il paziente "
            f"{paziente.nome} {paziente.cognome}."
        )


# CLASSE ANALISI

class Analisi:

    def __init__(self, tipo_analisi, risultato):

        self.tipo_analisi = tipo_analisi
        self.risultato = risultato

    # Metodo per valutare il risultato
    # Intervalli inventati a scopo didattico

    def valuta(self):

        if self.tipo_analisi == "glicemia":

            if 70 <= self.risultato <= 100:
                return "Nella norma (criterio didattico)"
            else:
                return "Fuori dall'intervallo didattico"

        elif self.tipo_analisi == "colesterolo":

            if 0 <= self.risultato <= 200:
                return "Nella norma (criterio didattico)"
            else:
                return "Fuori dall'intervallo didattico"

        elif self.tipo_analisi == "trigliceridi":

            if 0 <= self.risultato <= 150:
                return "Nella norma (criterio didattico)"
            else:
                return "Fuori dall'intervallo didattico"

        else:

            return "Criterio di valutazione non disponibile"


